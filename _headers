# WiggMap — Netlify response headers
# CSP enforced (was Report-Only since Sprint 1, no significant violations
# observed for ~weeks of production traffic). Origin allowlist below covers
# every external script/style/font/connect target observed in:
#   - Page <script src=...> tags (GTM, Leaflet via unpkg)
#   - Runtime injections (GA4 via GTM, Meta Pixel, Buttondown subscribe,
#     Supabase auth/db on connect/widget.js + mon-compte.html)
#   - Font loading (Google Fonts gstatic + googleapis)
#   - Form submissions (Netlify Forms newsletter)
# If new origin needed, extend the allowlist + redeploy.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://connect.facebook.net https://unpkg.com https://buttondown.email https://*.supabase.co https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.supabase.co wss://*.supabase.co https://buttondown.email https://connect.facebook.net https://api.buttondown.email; frame-src https://www.googletagmanager.com https://td.doubleclick.net; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://buttondown.email https://*.netlify.app

# Long-lived asset cache (images, icons)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assetscity/*
  Cache-Control: public, max-age=31536000, immutable

/imgindex/*
  Cache-Control: public, max-age=31536000, immutable

# JSON data — short cache, tolerates updates
/data/*.json
  Cache-Control: public, max-age=3600, must-revalidate

# Header / footer scripts — short cache, tolerates updates
/data/header.js
  Cache-Control: public, max-age=3600, must-revalidate

/data/footer.js
  Cache-Control: public, max-age=3600, must-revalidate

# Service worker must always revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Manifest revalidates daily
/manifest.webmanifest
  Cache-Control: public, max-age=86400
